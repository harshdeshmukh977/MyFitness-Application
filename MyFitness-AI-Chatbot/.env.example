# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Required ---
# Your Google Gemini API key. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional ---
# Model name. Change to a newer stable Gemini model without touching code.
# Current stable: gemini-3.7-flash (verified against Google's official documentation)
GEMINI_MODEL=gemini-3.7-flash
